# Optional override for the config file location.
AUDIO_RECORDING_SCRIBE_CONFIG=/absolute/path/to/config/settings.yaml

# Nested settings can be overridden with double underscores.
AUDIO_RECORDING_SCRIBE_DIRECTORIES__INBOX=data/inbox
AUDIO_RECORDING_SCRIBE_DIRECTORIES__OUTPUTS=data/outputs
AUDIO_RECORDING_SCRIBE_INGESTION__POLLING_INTERVAL_SECONDS=30
AUDIO_RECORDING_SCRIBE_TRANSCRIPTION__MODEL_SIZE=small
AUDIO_RECORDING_SCRIBE_LOGGING__LEVEL=INFO

